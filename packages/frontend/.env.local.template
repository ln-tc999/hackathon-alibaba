# Frontend Environment Variables

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# ============================================================================
# COMPOSIO CONFIGURATION (for OAuth and Social Media Integration)
# ============================================================================
# Get from https://app.composio.dev/

# Server-side API Key (REQUIRED for API routes)
COMPOSIO_API_KEY=your_composio_api_key_here

# Client-side API Key (optional, only if needed in browser)
NEXT_PUBLIC_COMPOSIO_API_KEY=your_composio_api_key_here

# OAuth Auth Config IDs (create in Composio Dashboard)
# Twitter: https://developer.twitter.com/
TWITTER_AUTH_CONFIG_ID=your_twitter_auth_config_id

# Facebook: https://developers.facebook.com/
FACEBOOK_AUTH_CONFIG_ID=your_facebook_auth_config_id

# Instagram: https://developers.facebook.com/ (same as Facebook)
INSTAGRAM_AUTH_CONFIG_ID=your_instagram_auth_config_id

# TikTok: https://developers.tiktok.com/
TIKTOK_AUTH_CONFIG_ID=your_tiktok_auth_config_id

# YouTube: https://console.cloud.google.com/
YOUTUBE_AUTH_CONFIG_ID=your_youtube_auth_config_id

# ============================================================================
# ALIBABA CLOUD CONFIGURATION (for AI Models & Image Generation)
# ============================================================================
# Get DashScope API Key from https://bailian.console.alibabacloud.com/
# Get Wan2 API Key from Alibaba Cloud Model Studio

# Qwen Models (Text Generation, Vision, etc.)
DASHSCOPE_API_KEY=your_dashscope_api_key_here
NEXT_PUBLIC_DASHSCOPE_API_KEY=your_dashscope_api_key_here
NEXT_PUBLIC_QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
NEXT_PUBLIC_QWEN_TEXT_MODEL=qwen-plus
NEXT_PUBLIC_QWEN_VISION_MODEL=qwen-vl-plus

# Wan2 Image Generation (uses same DashScope API key)
NEXT_PUBLIC_WAN2_API_KEY=your_dashscope_api_key_here
WAN2_API_KEY=your_dashscope_api_key_here
