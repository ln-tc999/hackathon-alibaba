---
---

<section class="relative pt-16 pb-20 md:pt-24 md:pb-32 overflow-hidden">
  <!-- Decorative orbs -->
  <div class="absolute top-20 left-10 w-72 h-72 bg-[#0446ff]/10 rounded-full blur-3xl animate-glow-pulse pointer-events-none">
  </div>
  <div class="absolute bottom-10 right-10 w-96 h-96 bg-indigo-500/8 rounded-full blur-3xl animate-glow-pulse pointer-events-none" style="animation-delay: 2s;">
  </div>

  <div class="max-w-7xl mx-auto px-6">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left: Text -->
      <div class="animate-fade-in-up">
        <div
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-none bg-[#0446ff]/10 border border-[#0446ff]/20 mb-8"
        >
          <span class="w-2 h-2 rounded-none bg-[#0446ff] animate-pulse"></span>
          <span class="text-xs font-medium text-[#0446ff]">Powered by Alibaba Cloud</span>
        </div>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">
          <span class="text-[#0446ff]">The best AI-powered</span><br />
          <span class="text-slate-900">workflow automation</span><br />
          <span class="gradient-text">platform</span>
        </h1>

        <p class="text-lg text-slate-600 max-w-lg mb-10 leading-relaxed">
          Visually build content workflows. Generate AI visuals with Wan2.1 and auto-publish to
          social media — all in one place.
        </p>

        <!-- Stats row -->
        <div class="flex gap-10 mb-8 pb-8 border-b border-slate-200/50">
          <div>
            <div class="text-2xl font-bold text-slate-900">10x</div>
            <div class="text-xs text-slate-600 mt-1">Faster Content</div>
          </div>
          <div>
            <div class="text-2xl font-bold text-slate-900">AI-Powered</div>
            <div class="text-xs text-slate-600 mt-1">Image Generation</div>
          </div>
          <div>
            <div class="text-2xl font-bold text-slate-900">100%</div>
            <div class="text-xs text-slate-600 mt-1">Automated Flow</div>
          </div>
        </div>

        <div class="flex flex-wrap gap-4">
          <a
            href="#how-it-works"
            class="btn-outline px-8 py-3.5 rounded-none text-base font-medium text-slate-700 bg-white inline-flex items-center gap-2 shadow-sm"
          >
            Learn More
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><circle cx="12" cy="12" r="10"></circle><path d="m12 16 4-4-4-4"></path><path
                d="M8 12h8"></path></svg
            >
          </a>
        </div>
      </div>

      <!-- Right: Hero Visual -->
      <div class="relative animate-fade-in-up delay-300">
        <!-- Main floating card -->
        <div class="relative z-10 glass-card rounded-none p-6 animate-float">
          <!-- Workflow preview mock -->
          <div class="bg-white/90 rounded-none p-5 border border-slate-200 shadow-sm">
            <div class="flex items-center gap-2 mb-4">
              <div class="w-3 h-3 rounded-none bg-red-400/80"></div>
              <div class="w-3 h-3 rounded-none bg-yellow-400/80"></div>
              <div class="w-3 h-3 rounded-none bg-green-400/80"></div>
              <span class="text-xs text-slate-500 ml-2">VlowGen Workflow</span>
            </div>

            <!-- Workflow nodes mock -->
            <div class="space-y-3">
              <!-- Node 1: Prompt -->
              <div
                class="flex items-center gap-3 bg-slate-50/80 rounded-none p-3 border border-slate-200/50 shadow-sm"
              >
                <div
                  class="w-8 h-8 rounded-none bg-purple-100 flex items-center justify-center flex-shrink-0"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#a78bfa"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
                    ></path></svg
                  >
                </div>
                <div class="flex-1 min-w-0">
                  <div class="text-xs font-medium text-slate-800">Prompt Text</div>
                  <div class="text-[10px] text-slate-500 truncate">
                    "A futuristic cyberpunk city at sunset..."
                  </div>
                </div>
                <div class="w-2 h-2 rounded-none bg-green-400 flex-shrink-0"></div>
              </div>

              <!-- Arrow -->
              <div class="flex justify-center">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#3b82f6"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg
                >
              </div>

              <!-- Node 2: Wan2.1 -->
              <div
                class="flex items-center gap-3 bg-blue-50/50 rounded-none p-3 border border-blue-200/50 shadow-sm"
              >
                <div
                  class="w-8 h-8 rounded-none bg-blue-100 flex items-center justify-center flex-shrink-0"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#60a5fa"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect><circle
                      cx="9"
                      cy="9"
                      r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"
                    ></path></svg
                  >
                </div>
                <div class="flex-1 min-w-0">
                  <div class="text-xs font-medium text-blue-700">Wan2.1 AI Generation</div>
                  <div class="text-[10px] text-slate-500">Alibaba Cloud • 1024×1024</div>
                </div>
                <div class="flex items-center gap-1">
                  <div class="w-1 h-3 bg-[#0446ff] rounded-none animate-pulse"></div>
                  <div
                    class="w-1 h-4 bg-[#0446ff] rounded-none animate-pulse"
                    style={{ animationDelay: '0.2s' }}
                  >
                  </div>
                  <div
                    class="w-1 h-2 bg-blue-300 rounded-none animate-pulse"
                    style={{ animationDelay: '0.4s' }}
                  >
                  </div>
                </div>
              </div>

              <!-- Arrow -->
              <div class="flex justify-center">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#3b82f6"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg
                >
              </div>

              <!-- Node 3: Twitter -->
              <div
                class="flex items-center gap-3 bg-cyan-50/50 rounded-none p-3 border border-cyan-200/50 shadow-sm"
              >
                <div
                  class="w-8 h-8 rounded-none bg-cyan-100 flex items-center justify-center flex-shrink-0"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#22d3ee"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path
                      d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"
                    ></path></svg
                  >
                </div>
                <div class="flex-1 min-w-0">
                  <div class="text-xs font-medium text-cyan-700">Post to Twitter/X</div>
                  <div class="text-[10px] text-slate-500">via Composio • Auto-post</div>
                </div>
                <div class="w-2 h-2 rounded-none bg-green-400 flex-shrink-0"></div>
              </div>
            </div>
          </div>
        </div>

        <!-- Background decorative elements -->
        <div class="absolute -top-8 -right-8 w-32 h-32 bg-[#0446ff]/5 rounded-none border border-[#0446ff]/10 animate-float-delay">
        </div>
        <div class="absolute -bottom-6 -left-6 w-24 h-24 bg-indigo-500/5 rounded-none border border-indigo-500/10 animate-float-slow">
        </div>

        <!-- Orbiting particles -->
        <div
          class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-4 h-4 animate-orbit"
        >
          <div class="w-2 h-2 rounded-full bg-[#0446ff]/60"></div>
        </div>
      </div>
    </div>
  </div>
</section>
