---
---

<section class="relative py-24 md:py-32">
  <div class="section-glow-divider mb-24"></div>
  <div class="absolute inset-0 radial-glow pointer-events-none opacity-20"></div>

  <div class="max-w-4xl mx-auto px-6 text-center relative z-10">
    <div class="glass-card rounded-none p-12 md:p-16">
      <div
        class="inline-flex items-center gap-2 px-4 py-1.5 rounded-none bg-[#0446ff]/10 border border-[#0446ff]/20 mb-6"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#60a5fa"
          stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg
        >
        <span class="text-xs font-medium text-[#0446ff]">Start Building Today</span>
      </div>

      <h2 class="text-3xl md:text-5xl font-bold text-slate-900 mb-4">
        Ready to automate your<br /><span class="gradient-text">content workflow?</span>
      </h2>
      <p class="text-slate-600 mb-10 max-w-lg mx-auto">
        Join VlowGen and start building AI-powered content automation workflows in minutes — no
        coding required.
      </p>

      <div class="flex flex-wrap justify-center gap-4">
        <button
          onclick="window.__setView('chat')"
          class="btn-primary px-10 py-4 rounded-none text-base font-semibold text-white inline-flex items-center gap-2"
        >
          Launch VlowGen
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg
          >
        </button>
        <a
          href="https://github.com/ln-tc999/hackathon-alibaba"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-outline px-8 py-4 rounded-none text-base font-medium text-slate-700 bg-white shadow-sm inline-flex items-center gap-2"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
            ></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg
          >
          View on GitHub
        </a>
      </div>

      <!-- Trust badges -->
      <div class="flex justify-center items-center gap-6 mt-10 pt-8 border-t border-slate-200">
        <div class="flex items-center gap-2 text-slate-600">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg
          >
          <span class="text-xs">Secure</span>
        </div>
        <div class="flex items-center gap-2 text-slate-600">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            ><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg
          >
          <span class="text-xs">Lightning Fast</span>
        </div>
        <div class="flex items-center gap-2 text-slate-600">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            ><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"
            ></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path
              d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg
          >
          <span class="text-xs">Open Source</span>
        </div>
      </div>
    </div>
  </div>
</section>
