---
// Components
---

<section id="our-team" class="py-24 md:py-32 relative overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute inset-0 bg-gradient-to-b from-white via-blue-50/30 to-white"></div>
  <div class="section-glow-divider mb-24"></div>
  <div class="absolute inset-0 radial-glow pointer-events-none opacity-20"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <!-- Section header -->
    <div class="text-center mb-20">
      <span class="text-sm font-semibold text-[#0446ff] tracking-wider uppercase">Our Team</span>
      <h2 class="text-3xl md:text-5xl font-bold text-slate-900 mt-3">
        Meet the <span class="gradient-text">Makers</span>
      </h2>
      <p class="text-slate-600 max-w-2xl mx-auto text-lg mt-4">
        The passionate team behind VlowGen, building tools for the next generation of creators.
      </p>
    </div>

    <!-- Team Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
      {/* Team Member 1 */}
      <div class="group relative">
        <div class="absolute inset-0 bg-gradient-to-br from-[#0446ff]/10 to-blue-600/10 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="relative bg-white border border-slate-200 p-8 rounded-2xl shadow-sm group-hover:shadow-xl group-hover:shadow-[#0446ff]/10 group-hover:-translate-y-1 transition-all duration-300 h-full flex flex-col">
          <!-- Avatar with gradient ring -->
          <div class="relative mb-6">
            <div class="absolute inset-0 bg-gradient-to-br from-[#0446ff] to-blue-600 rounded-full blur-sm opacity-75 group-hover:opacity-100 transition-opacity"></div>
            <img 
              src="https://i.pravatar.cc/150?img=11" 
              alt="Raka Ardiansyah" 
              class="relative w-24 h-24 rounded-full object-cover border-4 border-white shadow-lg" 
            />
          </div>
          
          {/* Info */}
          <h3 class="text-xl font-bold text-slate-900 mb-1">Raka Ardiansyah</h3>
          <p class="text-sm font-semibold text-[#0446ff] mb-4">Founder & Fullstack Developer</p>
          <p class="text-sm text-slate-500 mb-6 flex-1">
            Building scalable cloud architectures and obsessing over developer experience.
          </p>
          
          {/* Social Links */}
          <div class="flex items-center gap-3 pt-6 border-t border-slate-100">
            <a href="#" class="w-10 h-10 flex items-center justify-center rounded-full bg-slate-50 text-slate-400 hover:bg-[#0446ff] hover:text-white transition-all" aria-label="Github">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
            </a>
            <a href="#" class="w-10 h-10 flex items-center justify-center rounded-full bg-slate-50 text-slate-400 hover:bg-[#1DA1F2] hover:text-white transition-all" aria-label="Twitter">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
            </a>
            <a href="#" class="w-10 h-10 flex items-center justify-center rounded-full bg-slate-50 text-slate-400 hover:bg-[#E1306C] hover:text-white transition-all" aria-label="Instagram">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line></svg>
            </a>
          </div>
        </div>
      </div>

      {/* Team Member 2 */}
      <div class="group relative">
        <div class="absolute inset-0 bg-gradient-to-br from-[#0446ff]/10 to-blue-600/10 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="relative bg-white border border-slate-200 p-8 rounded-2xl shadow-sm group-hover:shadow-xl group-hover:shadow-[#0446ff]/10 group-hover:-translate-y-1 transition-all duration-300 h-full flex flex-col">
          <div class="relative mb-6">
            <div class="absolute inset-0 bg-gradient-to-br from-[#0446ff] to-blue-600 rounded-full blur-sm opacity-75 group-hover:opacity-100 transition-opacity"></div>
            <img 
              src="https://i.pravatar.cc/150?img=5" 
              alt="Dina Amelia" 
              class="relative w-24 h-24 rounded-full object-cover border-4 border-white shadow-lg" 
            />
          </div>
          
          <h3 class="text-xl font-bold text-slate-900 mb-1">Dina Amelia</h3>
          <p class="text-sm font-semibold text-[#0446ff] mb-4">Lead AI Engineer</p>
          <p class="text-sm text-slate-500 mb-6 flex-1">
            Fine-tuning models and creating the magic behind intelligent workflows.
          </p>
          
          <div class="flex items-center gap-3 pt-6 border-t border-slate-100">
            <a href="#" class="w-10 h-10 flex items-center justify-center rounded-full bg-slate-50 text-slate-400 hover:bg-[#0446ff] hover:text-white transition-all" aria-label="Github">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
            </a>
            <a href="#" class="w-10 h-10 flex items-center justify-center rounded-full bg-slate-50 text-slate-400 hover:bg-[#1DA1F2] hover:text-white transition-all" aria-label="Twitter">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
            </a>
            <a href="#" class="w-10 h-10 flex items-center justify-center rounded-full bg-slate-50 text-slate-400 hover:bg-[#E1306C] hover:text-white transition-all" aria-label="Instagram">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line></svg>
            </a>
          </div>
        </div>
      </div>

      {/* Team Member 3 */}
      <div class="group relative">
        <div class="absolute inset-0 bg-gradient-to-br from-[#0446ff]/10 to-blue-600/10 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        <div class="relative bg-white border border-slate-200 p-8 rounded-2xl shadow-sm group-hover:shadow-xl group-hover:shadow-[#0446ff]/10 group-hover:-translate-y-1 transition-all duration-300 h-full flex flex-col">
          <div class="relative mb-6">
            <div class="absolute inset-0 bg-gradient-to-br from-[#0446ff] to-blue-600 rounded-full blur-sm opacity-75 group-hover:opacity-100 transition-opacity"></div>
            <img 
              src="https://i.pravatar.cc/150?img=12" 
              alt="Budi Santoso" 
              class="relative w-24 h-24 rounded-full object-cover border-4 border-white shadow-lg" 
            />
          </div>
          
          <h3 class="text-xl font-bold text-slate-900 mb-1">Budi Santoso</h3>
          <p class="text-sm font-semibold text-[#0446ff] mb-4">Product Designer</p>
          <p class="text-sm text-slate-500 mb-6 flex-1">
            Crafting intuitive user interfaces and seamless component experiences.
          </p>
          
          <div class="flex items-center gap-3 pt-6 border-t border-slate-100">
            <a href="#" class="w-10 h-10 flex items-center justify-center rounded-full bg-slate-50 text-slate-400 hover:bg-[#0446ff] hover:text-white transition-all" aria-label="Github">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
            </a>
            <a href="#" class="w-10 h-10 flex items-center justify-center rounded-full bg-slate-50 text-slate-400 hover:bg-[#1DA1F2] hover:text-white transition-all" aria-label="Twitter">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
            </a>
            <a href="#" class="w-10 h-10 flex items-center justify-center rounded-full bg-slate-50 text-slate-400 hover:bg-[#E1306C] hover:text-white transition-all" aria-label="Instagram">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
