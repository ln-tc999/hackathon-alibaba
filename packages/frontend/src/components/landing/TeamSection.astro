---
// Components
---

<section id="our-team" class="py-24 md:py-32 relative overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute inset-0 bg-gradient-to-b from-white via-blue-50/30 to-white"></div>
  <div class="section-glow-divider mb-24"></div>
  <div class="absolute inset-0 radial-glow pointer-events-none opacity-20"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <!-- Section header -->
    <div class="text-center mb-20">
      <span class="text-sm font-semibold text-[#0446ff] tracking-wider uppercase">Our Team</span>
      <h2 class="text-3xl md:text-5xl font-bold text-slate-900 mt-3">
        Meet the <span class="gradient-text">Makers</span>
      </h2>
      <p class="text-slate-600 max-w-2xl mx-auto text-lg mt-4">
        The passionate team behind VlowGen, building tools for the next generation of creators.
      </p>
    </div>

    <!-- Team Grid - Match FeaturesSection card size -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {/* Team Member 1 */}
      <div class="glass-card rounded-none p-8 group relative overflow-hidden flex flex-col min-h-[300px]">
        <!-- Decorative Background -->
        <div
          class="absolute top-0 right-0 w-64 h-64 bg-[#0446ff]/10 rounded-full blur-3xl -mr-10 -mt-10 pointer-events-none group-hover:bg-[#0446ff]/20 transition-all duration-500"
        >
        </div>

        <!-- Avatar - Square to match card style -->
        <div class="relative z-10 w-20 h-20 rounded-none bg-gradient-to-br from-[#0446ff] to-blue-600 flex items-center justify-center mb-6 icon-glow overflow-hidden">
          <img 
            src="https://i.pravatar.cc/150?img=11" 
            alt="Raka Ardiansyah" 
            class="w-full h-full object-cover"
          />
        </div>
        
        <!-- Info -->
        <div class="relative z-10 mt-auto">
          <h3 class="text-xl font-bold text-slate-900 mb-1 tracking-tight">Raka Ardiansyah</h3>
          <p class="text-sm font-semibold text-[#0446ff]">Founder & Fullstack Developer</p>
        </div>
      </div>

      {/* Team Member 2 */}
      <div class="glass-card rounded-none p-8 group relative overflow-hidden flex flex-col min-h-[300px]">
        <!-- Decorative Background -->
        <div
          class="absolute top-0 right-0 w-64 h-64 bg-[#0446ff]/10 rounded-full blur-3xl -mr-10 -mt-10 pointer-events-none group-hover:bg-[#0446ff]/20 transition-all duration-500"
        >
        </div>

        <!-- Avatar - Square to match card style -->
        <div class="relative z-10 w-20 h-20 rounded-none bg-gradient-to-br from-[#0446ff] to-blue-600 flex items-center justify-center mb-6 icon-glow overflow-hidden">
          <img 
            src="https://i.pravatar.cc/150?img=5" 
            alt="Dina Amelia" 
            class="w-full h-full object-cover"
          />
        </div>
        
        <!-- Info -->
        <div class="relative z-10 mt-auto">
          <h3 class="text-xl font-bold text-slate-900 mb-1 tracking-tight">Dina Amelia</h3>
          <p class="text-sm font-semibold text-[#0446ff]">Lead AI Engineer</p>
        </div>
      </div>

      {/* Team Member 3 */}
      <div class="glass-card rounded-none p-8 group relative overflow-hidden flex flex-col min-h-[300px]">
        <!-- Decorative Background -->
        <div
          class="absolute top-0 right-0 w-64 h-64 bg-[#0446ff]/10 rounded-full blur-3xl -mr-10 -mt-10 pointer-events-none group-hover:bg-[#0446ff]/20 transition-all duration-500"
        >
        </div>

        <!-- Avatar - Square to match card style -->
        <div class="relative z-10 w-20 h-20 rounded-none bg-gradient-to-br from-[#0446ff] to-blue-600 flex items-center justify-center mb-6 icon-glow overflow-hidden">
          <img 
            src="https://i.pravatar.cc/150?img=12" 
            alt="Budi Santoso" 
            class="w-full h-full object-cover"
          />
        </div>
        
        <!-- Info -->
        <div class="relative z-10 mt-auto">
          <h3 class="text-xl font-bold text-slate-900 mb-1 tracking-tight">Budi Santoso</h3>
          <p class="text-sm font-semibold text-[#0446ff]">Product Designer</p>
        </div>
      </div>
    </div>
  </div>
</section>
