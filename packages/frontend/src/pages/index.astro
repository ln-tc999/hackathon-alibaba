---
import LandingLayout from '../layouts/LandingLayout.astro';
import Navbar from '../components/landing/Navbar.astro';
import HeroSection from '../components/landing/HeroSection.astro';
import FeaturesSection from '../components/landing/FeaturesSection.astro';
import HowItWorksSection from '../components/landing/HowItWorksSection.astro';
import PoweredBySection from '../components/landing/PoweredBySection.astro';
import GetStartedSection from '../components/landing/GetStartedSection.astro';
import Footer from '../components/landing/Footer.astro';
import AppContainer from '../components/AppContainer';
import '../styles/globals.css';
---

<LandingLayout>
  <!-- Landing View (Astro components) -->
  <div id="landing-view" class="transition-opacity duration-500">
    <!-- Background Effects -->
    <div class="fixed inset-0 bg-grid-pattern pointer-events-none z-0"></div>
    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-[1200px] h-[600px] radial-glow-top pointer-events-none z-0 opacity-60"></div>

    <Navbar />
    <HeroSection />
    <FeaturesSection />
    <HowItWorksSection />
    <PoweredBySection />
    <GetStartedSection />
    <Footer />
  </div>

  <!-- App View (React component) -->
  <AppContainer client:only="react" />

  <!-- Client-side script for handling launch app -->
  <script>
    // Handle all "Launch VlowGen" / "Get Started" buttons
    document.addEventListener('DOMContentLoaded', () => {
      const launchButtons = document.querySelectorAll('a[href="/app"], a[href="#app"]');
      
      launchButtons.forEach(button => {
        button.addEventListener('click', (e) => {
          e.preventDefault();
          window.location.hash = 'app';
        });
      });
    });
  </script>
</LandingLayout>
