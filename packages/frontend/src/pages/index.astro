---
import LandingLayout from '../layouts/LandingLayout.astro';
import Navbar from '../components/landing/Navbar.astro';
import HeroSection from '../components/landing/HeroSection.astro';
import FeaturesSection from '../components/landing/FeaturesSection.astro';
import HowItWorksSection from '../components/landing/HowItWorksSection.astro';
import PoweredBySection from '../components/landing/PoweredBySection.astro';
import KineticTeamHybrid from '@/components/ui/kinetic-team-hybrid';
import GetStartedSection from '../components/landing/GetStartedSection.astro';
import Footer from '../components/landing/Footer.astro';
import App from '../components/App';
import '../styles/globals.css';

const preconnect = ['https://fonts.googleapis.com', 'https://fonts.gstatic.com'];
---

<LandingLayout>
  <!-- Global state for SPA view management -->
  <script is:inline>
    window.__currentView = 'landing';
    window.__setView = function (view) {
      window.__currentView = view;
      const landing = document.getElementById('landing-page');
      const appRoot = document.getElementById('app-root');

      if (view === 'landing') {
        if (landing) {
          landing.style.display = 'block';
          setTimeout(() => {
            landing.style.opacity = '1';
          }, 10);
        }
        if (appRoot) {
          appRoot.style.opacity = '0';
          appRoot.style.pointerEvents = 'none';
        }
      } else {
        if (landing) {
          landing.style.opacity = '0';
          setTimeout(() => {
            landing.style.display = 'none';
          }, 300);
        }
        if (appRoot) {
          appRoot.style.opacity = '1';
          appRoot.style.pointerEvents = 'auto';
        }
      }

      window.dispatchEvent(new CustomEvent('viewChange', { detail: { view } }));
    };
  </script>

  <!-- Landing Page - Full Astro Components -->
  <div id="landing-page">
    <!-- Background Effects -->
    <div class="fixed inset-0 bg-grid-pattern pointer-events-none z-0"></div>
    <div
      class="fixed top-0 left-1/2 -translate-x-1/2 w-[1200px] h-[600px] radial-glow-top pointer-events-none z-0 opacity-60"
    >
    </div>

    <!-- Navigation -->
    <Navbar />

    <!-- Main Landing Content -->
    <main id="landing-main">
      <div id="landing-view">
        <HeroSection />
        <FeaturesSection />
        <HowItWorksSection />
        <PoweredBySection />
        <KineticTeamHybrid client:visible />
        <GetStartedSection />
      </div>
      <Footer />
    </main>
  </div>

  <!-- React App - All interactive views -->
  <div id="app-root">
    <App client:only="react" />
  </div>

  <!-- Preconnect to external resources -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
</LandingLayout>

<style>
  /* Landing page - visible by default */
  #landing-page {
    position: relative;
    min-height: 100vh;
    width: 100%;
    z-index: 1;
    opacity: 1;
    transition: opacity 0.3s ease;
    overflow-y: auto; /* Landing scroll dengan Lenis */
  }

  /* App root - hidden by default, shown when view != 'landing' */
  #app-root {
    position: relative;
    width: 100%;
    min-height: 100vh;
    z-index: 50;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    overflow-y: auto; /* App scroll native browser */
  }

  /* Landing main content - scrollable */
  #landing-main {
    position: relative;
    z-index: 10;
  }

  #landing-view {
    position: relative;
    z-index: 10;
  }
</style>
