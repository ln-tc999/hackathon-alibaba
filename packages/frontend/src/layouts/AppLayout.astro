---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'VlowGen - AI Workflow Platform',
  description = 'Build powerful content automation workflows using AI-powered workflow builder.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content="AI workflow, automation, content generation, visual workflow, autonomous AI" />
    <meta name="author" content="VlowGen Team" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="VlowGen" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/logo.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/logo.png" />

    <!-- Google Fonts - Space Grotesk -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <!-- ReactFlow styles -->
    <style is:global>
      @import 'reactflow/dist/style.css';
    </style>
  </head>
  <body class="h-full bg-gray-50 antialiased font-sans overflow-hidden m-0 p-0">
    <!-- App container with fixed viewport height -->
    <div id="app-root" class="h-full w-full overflow-hidden">
      <slot />
    </div>
  </body>
</html>
