# ============================================================================
# VlowGen Platform Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env files with real credentials to version control
# ============================================================================

# ============================================================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================================================
# These variables are used by the Next.js frontend application
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser

# Backend API URL
# Description: The URL where the backend API server is running
# Example: http://localhost:3001 (development) or https://api.vlowgen.com (production)
NEXT_PUBLIC_API_URL=http://localhost:3001

# ============================================================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================================================
# These variables are used by the Node.js backend API server
# Keep these values secure and never expose them to the frontend

# Server Port
# Description: The port number where the backend API server will listen
# Example: 3001 (default), 8080, or any available port
PORT=3001

# Wan2.1 API Key (Alibaba Cloud)
# Description: Authentication key for Alibaba Cloud's Wan2.1 text-to-image generation service
# How to obtain: Sign up at https://dashscope.aliyun.com/ and create an API key
# Example: sk-1234567890abcdef1234567890abcdef
WAN2_API_KEY=your_wan2_api_key_here

# Wan2.1 API URL
# Description: Base URL for the Wan2.1 API endpoint
# Default: https://dashscope.aliyuncs.com/api/v1/services/aigc/text2image/image-synthesis
# Note: Only change this if using a different region or custom endpoint
WAN2_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text2image/image-synthesis

# Composio API Key
# Description: Authentication key for Composio integration platform (used for Twitter posting)
# How to obtain: Sign up at https://composio.dev/ and generate an API key
# Example: comp_1234567890abcdef1234567890abcdef
COMPOSIO_API_KEY=your_composio_api_key_here

# Composio API URL
# Description: Base URL for the Composio API endpoint
# Default: https://api.composio.dev
# Note: Only change this if using a self-hosted or custom Composio instance
COMPOSIO_API_URL=https://api.composio.dev

# OpenRouter API Key
# Description: Authentication key for OpenRouter API (for AI models and image generation)
# How to obtain: Sign up at https://openrouter.ai/ and generate an API key
# Example: sk-or-v1-1234567890abcdef1234567890abcdef
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Models Configuration
# Image Generation Model: bytedance-seed/seedream-4.5
# Image to Text Model: qwen/qwen3-vl-30b-a3b-thinking
# Video to Text Model: nvidia/nemotron-nano-12b-v2-vl:free
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5
OPENROUTER_IMAGE_TO_TEXT_MODEL=qwen/qwen3-vl-30b-a3b-thinking
OPENROUTER_VIDEO_TO_TEXT_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# Composio OAuth Configuration
# Twitter Auth Config ID (from Composio Dashboard)
TWITTER_AUTH_CONFIG_ID=your_twitter_auth_config_id
# Facebook Auth Config ID
FACEBOOK_AUTH_CONFIG_ID=your_facebook_auth_config_id
# TikTok Auth Config ID
TIKTOK_AUTH_CONFIG_ID=your_tiktok_auth_config_id
# YouTube Auth Config ID
YOUTUBE_AUTH_CONFIG_ID=your_youtube_auth_config_id

# ============================================================================
# SHARED ENVIRONMENT VARIABLES
# ============================================================================
# These variables affect both frontend and backend behavior

# Node Environment
# Description: Specifies the runtime environment (affects logging, error handling, etc.)
# Options: development, production, test
# Example: development (for local dev), production (for deployed environments)
NODE_ENV=development

# Log Level
# Description: Controls the verbosity of application logs
# Options: error, warn, info, debug, trace
# Example: debug (for development), info (for production)
LOG_LEVEL=debug

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
# 1. Copy this file: cp .env.template .env
# 2. Obtain API keys from the services listed above
# 3. Replace placeholder values with your actual credentials
# 4. Ensure .env is listed in .gitignore (it should be by default)
# 5. For production deployment, set NODE_ENV=production and LOG_LEVEL=info
# ============================================================================
