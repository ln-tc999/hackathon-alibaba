# ============================================================================
# VlowGen Platform Production Environment Variables
# ============================================================================
# Copy this file to .env.production and fill in your actual values
# This file is used for Docker deployment
# ============================================================================

# Frontend Environment Variables
NEXT_PUBLIC_API_URL=https://your-domain.com/api

# Backend Environment Variables
PORT=3001
NODE_ENV=production
LOG_LEVEL=info

# ============================================================================
# COMPOSIO CONFIGURATION (for OAuth and Social Media Integration)
# ============================================================================
COMPOSIO_API_KEY=your_composio_api_key_here
COMPOSIO_API_URL=https://api.composio.dev

# OAuth Auth Config IDs (create in Composio Dashboard)
TWITTER_AUTH_CONFIG_ID=your_twitter_auth_config_id
FACEBOOK_AUTH_CONFIG_ID=your_facebook_auth_config_id
INSTAGRAM_AUTH_CONFIG_ID=your_instagram_auth_config_id
TIKTOK_AUTH_CONFIG_ID=your_tiktok_auth_config_id
YOUTUBE_AUTH_CONFIG_ID=your_youtube_auth_config_id

# ============================================================================
# OPENROUTER CONFIGURATION (Primary AI Provider)
# ============================================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model Configuration
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5
OPENROUTER_IMAGE_TO_TEXT_MODEL=qwen/qwen3-vl-30b-a3b-thinking
OPENROUTER_VIDEO_TO_TEXT_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# ============================================================================
# ALIBABA CLOUD WAN2.1 (Optional - Alternative Image Generation)
# ============================================================================
WAN2_API_KEY=your_wan2_api_key_here
WAN2_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text2image/image-synthesis
