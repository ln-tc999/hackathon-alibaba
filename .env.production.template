# ============================================================================
# VlowGen Platform Production Environment Variables
# ============================================================================
# Copy this file to .env.production and fill in your actual values
# This file is used for Docker deployment
# ============================================================================

# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://your-domain.com:3001
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Backend Environment Variables
PORT=3001
NODE_ENV=production
LOG_LEVEL=info

# Alibaba Cloud Wan2.1 API (Optional - can use OpenRouter instead)
WAN2_API_KEY=your_wan2_api_key_here
WAN2_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text2image/image-synthesis

# OpenRouter API (Alternative to Wan2.1 for development/cost savings)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Composio API for Twitter integration
COMPOSIO_API_KEY=your_composio_api_key_here
COMPOSIO_API_URL=https://api.composio.dev