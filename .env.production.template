# ============================================================================
# VlowGen Platform Production Environment Variables
# ============================================================================
# Copy this file to .env.production and fill in your actual values
# This file is used for Docker deployment
# ============================================================================

# Frontend Environment Variables (Astro)
PUBLIC_API_URL=https://your-domain.com/api

# Backend Environment Variables
PORT=3001
NODE_ENV=production
LOG_LEVEL=info

# ============================================================================
# COMPOSIO CONFIGURATION (for OAuth and Social Media Integration)
# ============================================================================
COMPOSIO_API_KEY=your_composio_api_key_here
COMPOSIO_API_URL=https://api.composio.dev

# Public Composio key (for client-side)
PUBLIC_COMPOSIO_API_KEY=your_composio_api_key_here

# OAuth Auth Config IDs (create in Composio Dashboard)
TWITTER_AUTH_CONFIG_ID=your_twitter_auth_config_id
FACEBOOK_AUTH_CONFIG_ID=your_facebook_auth_config_id
INSTAGRAM_AUTH_CONFIG_ID=your_instagram_auth_config_id
TIKTOK_AUTH_CONFIG_ID=your_tiktok_auth_config_id
YOUTUBE_AUTH_CONFIG_ID=your_youtube_auth_config_id

# ============================================================================
# ALIBABA CLOUD DASHSCOPE CONFIGURATION (Primary AI Provider)
# ============================================================================
# DashScope API Key (used for Qwen models and Wan2 image generation)
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Model Configuration
QWEN_TEXT_MODEL=qwen-plus
QWEN_VISION_MODEL=qwen-vl-plus
WAN2_IMAGE_MODEL=wan2.1-t2i-turbo

# Wan2 API URL (for image generation)
WAN2_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text2image/image-synthesis

# Public API Keys (for client-side)
PUBLIC_WAN2_API_KEY=your_wan2_api_key_here
PUBLIC_OPENROUTER_API_KEY=your_openrouter_api_key_here
