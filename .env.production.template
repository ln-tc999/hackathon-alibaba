# Production Environment Configuration
# Copy this file to .env.production and fill in your values

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=production
PORT=3001
LOG_LEVEL=info
APP_VERSION=1.0.0

# ============================================
# SSL/TLS CONFIGURATION
# ============================================
USE_SSL=true
SSL_CERT_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem

# ============================================
# API SECURITY
# ============================================
REQUIRE_API_KEY=true
API_KEY=your-strong-random-api-key-here

# ============================================
# CORS CONFIGURATION
# ============================================
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================
# ALIBABA CLOUD DASHSCOPE
# ============================================
DASHSCOPE_API_KEY=sk-your-production-key-here
WAN2_API_URL=https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/text2image/image-synthesis

# ============================================
# COMPOSIO (Social Media Integration)
# ============================================
COMPOSIO_API_KEY=ak_your-production-key-here
COMPOSIO_API_URL=https://api.composio.dev

# ============================================
# MINIO OBJECT STORAGE
# ============================================
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your-strong-random-access-key
MINIO_SECRET_KEY=your-strong-random-secret-key
MINIO_BUCKET_NAME=vlowgen-images

# ============================================
# FRONTEND CONFIGURATION
# ============================================
PUBLIC_API_URL=https://yourdomain.com/api
PUBLIC_WAN2_API_KEY=sk-your-public-key-here
PUBLIC_OPENROUTER_API_KEY=your-openrouter-key-here
PUBLIC_COMPOSIO_API_KEY=ak_your-public-key-here
PUBLIC_FINGERPRINT_API_KEY=your-fingerprint-key-here

# ============================================
# SOCIAL MEDIA AUTH CONFIG IDS
# ============================================
TWITTER_AUTH_CONFIG_ID=your-twitter-config-id
FACEBOOK_AUTH_CONFIG_ID=your-facebook-config-id
INSTAGRAM_AUTH_CONFIG_ID=your-instagram-config-id
TIKTOK_AUTH_CONFIG_ID=your-tiktok-config-id
YOUTUBE_AUTH_CONFIG_ID=your-youtube-config-id

# ============================================
# DATABASE (Optional)
# ============================================
# DATABASE_URL=postgresql://user:password@postgres:5432/vlowgen

# ============================================
# REDIS (Optional)
# ============================================
# REDIS_URL=redis://redis:6379

# ============================================
# MONITORING & LOGGING
# ============================================
# SENTRY_DSN=your-sentry-dsn
# NEW_RELIC_LICENSE_KEY=your-new-relic-key

# ============================================
# BACKUP & MAINTENANCE
# ============================================
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
# BACKUP_RETENTION_DAYS=7

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# SECURITY HEADERS
# ============================================
# These are set automatically by the security middleware
# HSTS_MAX_AGE=31536000
# CSP_POLICY=default-src 'self'
